# Скопируйте в .env. Файл один на репозиторий: его читают docker compose и мок-сервер
# при npm run dev. Без .env действуют эти же значения.

# Порты на хосте для docker compose. 5173 и 3001 заняты npm run dev.
PORT_WEB=8080
PORT_API=3002

# Ключ Timeweb AI для разбора поисковой фразы моделью. Пусто — модели нет, поиск текстовый.
# Временный ключ для демо — протухнет, замените на свой.
LLM_API_KEY=sk-lFUC5GaXjN25pLEv_zb7SQ

# Интервал генерации патчей после POST /api/dev/stream/start без intervalMs, мс.
STREAM_INTERVAL_MS=5000

# docker compose: генерация патчей стартует сама после запуска api. false — данные мока
# не меняются, пока генерацию не включат вручную (POST /api/dev/stream/start).
STREAM_AUTOSTART=true
